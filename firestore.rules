rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Le profil (stats + pseudo) est lisible par tout utilisateur connecté afin
    // de permettre le classement entre amis ; seul le propriétaire peut l'écrire.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Demandes d'amis reçues par ce joueur : l'expéditeur crée le document
      // (avec son propre uid comme id), le destinataire lit/refuse/accepte
      // (accepter = lire puis supprimer côté client après avoir créé les amitiés).
      match /incomingRequests/{fromUid} {
        allow read, delete: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == fromUid);
        allow create: if request.auth != null && request.auth.uid == fromUid;
        allow update: if false;
      }

      // Relation d'amitié bidirectionnelle : chaque camp ne peut créer/supprimer
      // que le document dont il est l'une des deux parties (soi-même ou l'ami).
      match /friends/{friendUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow update: if false;
      }
    }

    // Table d'unicité des pseudos : lecture ouverte (recherche d'amis), création
    // uniquement par le propriétaire du compte pour son propre uid, jamais de
    // modification (un pseudo pris reste pris).
    match /usernames/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Le personnage du jour est public en lecture (tout le monde doit pouvoir
    // savoir quel index a été tiré) ; la création est ouverte à tout utilisateur
    // connecté mais seulement si le document n'existe pas encore, et les compteurs
    // agrégés (solvedCount / guessesSum) ne peuvent qu'être incrémentés.
    match /dailyChallenges/{date} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.characterIndex == resource.data.characterIndex;

      // Sous-document servant à ne compter qu'une seule fois chaque joueur.
      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }
  }
}
